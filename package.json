{
  "name": "pokered3d",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:decomp": "git clone --depth 1 https://github.com/pret/pokefirered.git vendor/pokefirered",
    "classify": "node tools/baker/classify.js",
    "bake": "node tools/baker/bake.js",
    "playthrough": "node tests/playthrough/record.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:single": "tsc --noEmit && vite build --mode single"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "0.160.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11",
    "yaml": "^2.6.1"
  },
  "dependencies": {
    "three": "0.160.0"
  }
}
